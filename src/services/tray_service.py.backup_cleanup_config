from __future__ import annotations

import os
import socket
import subprocess
import sys
import tempfile
import threading

from gi.repository import GLib

from src.managers.config_manager import ConfigManager


class TrayService:
    name = "TrayService"

    def __init__(self, event_bus=None):
        self.event_bus = event_bus

        self.config = ConfigManager()
        self.config.load()

        self.application = None
        self.window = None
        self.process = None
        self.socket_path = os.path.join(
            tempfile.gettempdir(),
            f"clipboard_guardian_tray_{os.getuid()}.sock",
        )
        self.server = None
        self.running = False

    def set_application(self, app):
        self.application = app

    def set_window(self, window):
        self.window = window

    def initialize(self):

        config = ConfigManager()
        config.load()

        if self.event_bus is not None:

            self.event_bus.monitoring_enabled = (
                config.get_default(
                    "monitoring",
                    True
                )
            )

            self.event_bus.notify_enabled = (
                config.get_default(
                    "notifications",
                    True
                )
            )

            self.event_bus.toast_enabled = (
                config.get_default(
                    "toast",
                    True
                )
            )

    def start(self):
        self.running = True
        self.start_ipc_server()
        self.start_tray_process()

    def stop(self):
        self.running = False

        try:
            if self.process:
                self.process.terminate()
        except Exception:
            pass

        try:
            if self.server:
                self.server.close()
        except Exception:
            pass

        try:
            if os.path.exists(self.socket_path):
                os.remove(self.socket_path)
        except Exception:
            pass

    def start_ipc_server(self):
        if os.path.exists(self.socket_path):
            os.remove(self.socket_path)

        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(self.socket_path)
        self.server.listen(5)

        thread = threading.Thread(target=self.accept_loop, daemon=True)
        thread.start()

    def start_tray_process(self):
        env = os.environ.copy()
        env["CLIPBOARD_GUARDIAN_TRAY_SOCKET"] = self.socket_path

        self.process = subprocess.Popen(
            [sys.executable, "-m", "src.tray.tray_process"],
            env=env,
        )

    def accept_loop(self):
        while self.running:
            try:
                conn, _ = self.server.accept()
                with conn:
                    command = conn.recv(1024).decode("utf-8").strip()
                    if command:
                        GLib.idle_add(self.handle_command, command)
            except Exception:
                break

    def handle_command(self, command: str):
        if command == "show_window":
            if self.window:
                self.window.present()

        elif command == "hide_window":
            if self.window:
                self.window.hide()

        elif command == "monitoring_on":
            if self.event_bus:
                self.event_bus.monitoring_enabled = True
                self.config.set_default("monitoring", True)
                self.config.save()

        elif command == "monitoring_off":
            if self.event_bus:
                self.event_bus.monitoring_enabled = False
                self.config.set_default("monitoring", False)
                self.config.save()

        elif command == "notify_on":
            if self.event_bus:
                self.event_bus.notify_enabled = True
                self.config.set_default("notifications", True)
                self.config.save()

        elif command == "notify_off":
            if self.event_bus:
                self.event_bus.notify_enabled = False
                self.config.set_default("notifications", False)
                self.config.save()

        elif command == "toast_on":
            if self.event_bus:
                self.event_bus.toast_enabled = True
                self.config.set_default("toast", True)
                self.config.save()

        elif command == "toast_off":
            if self.event_bus:
                self.event_bus.toast_enabled = False
                self.config.set_default("toast", False)
                self.config.save()

        elif command == "refresh":
            if self.window:
                self.window.queue_draw()

        elif command == "clear_history":
            if self.window and hasattr(self.window, "clear_history"):
                self.window.clear_history()


        elif command == "open_settings":

            from src.gui.windows.settings_window import SettingsWindow

            if self.application:

                settings = SettingsWindow(
                    self.application,
                )

                settings.present()


        elif command == "quit":
            if self.application:
                self.application.quit()

        return False
